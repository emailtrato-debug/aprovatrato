# Copie para .env.local (no seu computador) e preencha. Na Vercel, cadastre as mesmas variáveis
# em Settings > Environment Variables. NUNCA coloque valores reais neste arquivo.

# Obrigatório. ClickUp > seu avatar > Configurações > Apps > API Token (começa com pk_).
CLICKUP_API_TOKEN=

# Webhook do ClickUp (deixa o portal atualizado na hora). Gerado por: npm run webhook -- criar <url>
CLICKUP_WEBHOOK_SECRET=

# Log das ações em banco gratuito (Upstash Redis, pela Marketplace da Vercel). Opcional.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Só para os comandos de linha (npm run clientes, npm run webhook). Valores já têm padrão.
# PORTAL_URL=https://aprovetrato.com.br
# CLICKUP_TEAM_ID=9010127467
# CLICKUP_SOCIAL_MEDIA_FOLDER_ID=901318383354

# Mostra a rota de teste /demo em produção. Deixe desligado.
# HABILITAR_DEMO=1
